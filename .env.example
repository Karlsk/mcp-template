# ---- MCP server runtime ----
# Address and port the Streamable HTTP server binds to.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_LOG_LEVEL=INFO

# ---- SDN controller secrets (NEVER commit real values) ----
# Leave empty to run in "skeleton mode" (server boots, SDN tools report
# configured=false). Required only when calling real SDN endpoints.
# Bearer token (when SDN_AUTH_TYPE=bearer):
SDN_TOKEN=
# Basic auth (when SDN_AUTH_TYPE=basic):
SDN_USERNAME=
SDN_PASSWORD=

# Optional: override the YAML config file path.
# SDN_CONFIG_FILE=config/sdn_controller.yaml
