# ---- MCP server runtime ----
# Address and port the Streamable HTTP server binds to.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
MCP_LOG_LEVEL=INFO

# ---- SDN controller connection (NEVER commit real values) ----
# Leave base_url empty to run in "skeleton mode" (server boots, SDN tools report
# configured=false). Required when calling real SDN endpoints.
SDN_CONTROLLER_BASE_URL=
# auth_type=basic (login with username/password, auto token refresh on 401):
SDN_CONTROLLER_USERNAME=
SDN_CONTROLLER_PASSWORD=
# auth_type=bearer (fixed api-key):
SDN_CONTROLLER_TOKEN=

# Optional: override the YAML config file path.
# SDN_CONFIG_FILE=config/sdn_controller.yaml

# Optional: override the command template library path.
# COMMAND_TEMPLATE_FILE=config/command_templates.yaml

# ---- SOP graph (Neo4j) ----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=
NEO4J_PASSWORD=
