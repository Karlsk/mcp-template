# Build artifacts & caches
.git
.gitignore
.venv
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/

# Tests & docs are not needed in the runtime image
tests/
scripts/
.env.example
# NOTE: README.md is required by the build (pyproject.toml references it), so it
# must NOT be excluded here.

# Local secrets (never bake into an image)
.env
.env.*
config/*local*.yaml
